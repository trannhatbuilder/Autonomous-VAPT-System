# ============================================================
# VAPT-AI v3.2 — FastAPI App systemd unit
# ============================================================
# Install:
#   sudo cp scripts/systemd/vapt-ai-app.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vapt-ai-app
#   sudo systemctl start vapt-ai-app
#
# Verify:
#   sudo systemctl status vapt-ai-app
#   journalctl -u vapt-ai-app -f
# ============================================================

[Unit]
Description=VAPT-AI FastAPI App (v3.2)
After=network.target redis-server.service postgresql.service msfrpcd.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=nhat
Group=nhat

WorkingDirectory=/home/nhat/VAPT-AI
Environment=PYTHONPATH=/home/nhat/VAPT-AI
EnvironmentFile=/home/nhat/VAPT-AI/.env

# CRITICAL — expand PATH so the service sees Go-installed security tools.
# systemd's default PATH is `/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/
# sbin:/bin` — it does NOT include `/home/nhat/go/bin` where `httpx`, `nuclei`,
# `subfinder`, `katana`, `dalfox`, `gau`, `waybackurls`, ... are installed via
# `go install github.com/projectdiscovery/...@latest`. Without this line, the
# agent reported "Binary not found: httpx" even though `which httpx` from a
# login shell found it fine.
#
# Also include /snap/bin (some tools via snap), /usr/local/go/bin (go binary
# itself), and the existing PATH as fallback.
Environment=PATH=/home/nhat/go/bin:/root/go/bin:/usr/local/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:/opt/go/bin

# Run uvicorn from venv (NOT system uvicorn)
#
# IMPORTANT: keep --workers 1.
# The scan SSE event bus (app/pentest/events.py) and the scan registry
# (app/pentest/scan_registry.py) are IN-PROCESS singletons. With >1 worker the
# POST /api/scans/start request is handled by one worker while the SSE
# GET /api/scans/{id}/events request can be load-balanced onto another, so the
# UI only ever receives heartbeats and never the scan_progress / tool_call
# events — even though the scan and its tools are running fine. Multi-worker
# support requires Redis pub/sub (see events.py "W14+ will add Redis pub/sub").
ExecStart=/home/nhat/VAPT-AI/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1

Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vapt-ai-app

# Security hardening
NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/home/nhat/VAPT-AI/data /home/nhat/VAPT-AI/logs
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target