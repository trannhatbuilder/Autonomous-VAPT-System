# ============================================================
# VAPT-AI v3.2 — FastAPI App systemd unit
# ============================================================
# Install:
#   sudo cp scripts/systemd/vapt-ai-app.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable vapt-ai-app
#   sudo systemctl start vapt-ai-app
#
# Verify:
#   sudo systemctl status vapt-ai-app
#   journalctl -u vapt-ai-app -f
# ============================================================

[Unit]
Description=VAPT-AI FastAPI App (v3.2)
After=network.target redis-server.service postgresql.service msfrpcd.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=nhat
Group=nhat

WorkingDirectory=/home/nhat/VAPT-AI
Environment=PYTHONPATH=/home/nhat/VAPT-AI
EnvironmentFile=/home/nhat/VAPT-AI/.env

# Run uvicorn from venv (NOT system uvicorn)
ExecStart=/home/nhat/VAPT-AI/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2

Restart=always
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=vapt-ai-app

# Security hardening
NoNewPrivileges=true
# PrivateTmp=true
# ProtectSystem=strict
# ProtectHome=read-only
# ReadWritePaths=/home/nhat/VAPT-AI/data /home/nhat/VAPT-AI/logs
# ProtectKernelTunables=true
# ProtectKernelModules=true
# ProtectControlGroups=true
# RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
