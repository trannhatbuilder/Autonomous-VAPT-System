# ============================================================
# VAPT-AI v3.2 — Environment Variables Template
# ============================================================
# Copy to .env and fill in your values.
#
# Variable naming:
#   VAPT_AI_*  — canonical VAPT-AI vars (preferred for new code)
#   EVVO_*     — legacy vars (kept for backward compat with 482 tests;
#                will be migrated in later weeks)
#   MSF_RPC_*  — Metasploit RPC connection
#   ANTHROPIC_/OPENAI_/etc. — LLM provider base URLs (API keys stored in DB)
#
# SECURITY: this file is committed to git. NEVER put real secrets here.
#           Real secrets go in .env (gitignored) or as systemd EnvironmentFile.

# ---------- App ----------
VAPT_AI_ENVIRONMENT=dev
VAPT_AI_DEBUG=true
VAPT_AI_LOG_LEVEL=INFO

# ---------- Database (PostgreSQL) ----------
# Canonical VAPT-AI var. Driver suffix is auto-added by app.core.config:
#   - postgresql://      → normalized to asyncpg (runtime) + psycopg2 (alembic)
#   - postgresql+asyncpg:// → kept as-is for async
#   - postgresql+psycopg2:// → kept as-is for sync
# NOTE: if password contains special chars (@, :, /, etc.), URL-encode them.
#   @ → %40     : → %3A     / → %2F     # → %23
# Example: password "vapt@NhatVKU" becomes "vapt%40NhatVKU" in the URL.
VAPT_AI_POSTGRES_DB=postgresql://vapt:vapt%40NhatVKU@localhost:5432/vapt_ai

# Legacy alias (optional — if set, overrides VAPT_AI_POSTGRES_DB for backward compat)
# EVVO_POSTGRES_DB=postgresql://vapt:vapt%40NhatVKU@localhost:5432/vapt_ai

# Connection pool
VAPT_AI_DB_POOL_MIN_CONN=2
VAPT_AI_DB_POOL_MAX_CONN=20

# ---------- Redis ----------
VAPT_AI_REDIS_URL=redis://localhost:6379/0
# EVVO_REDIS_URL=redis://localhost:6379/0  # legacy alias

# ---------- Auth (single user) ----------
VAPT_AI_ADMIN_EMAIL=admin@vapt-ai.local
# IMPORTANT: set a strong password in .env (NOT this template)
VAPT_AI_ADMIN_PASSWORD=change-me-to-a-strong-password
# JWT signing secret — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
VAPT_AI_JWT_SECRET=change-me-to-a-48-byte-secret
# Fernet encryption key for encrypting stored credentials (greybox scan logins, etc.)
# Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAPT_AI_ENCRYPTION_KEY=change-me-to-a-fernet-key
VAPT_AI_COOKIE_SECURE=true

# ---------- App URLs ----------
VAPT_AI_APP_URL=http://localhost:8000
VAPT_AI_API_URL=http://localhost:8000/api

# ---------- LLM Provider (Default) ----------
# Options: anthropic, openai, google, groq, deepseek, minimax, glm, ollama
VAPT_AI_MODEL_PROVIDER=glm
VAPT_AI_MODEL_ENABLED=true
VAPT_AI_MODEL_TIMEOUT_SECONDS=120

# ---------- HITL Audit Agent (W7-A — Option C: A-in-the-Loop) ----------
# A second LLM reviews every destructive op (metasploit exploit, sqlmap --os-shell,
# custom RCE, C2 L3+, payload gen). The audit agent decides approve / reject /
# suggest_alternative within ~2-3s — no human blocking. Decisions are logged
# to vapt_hitl_approvals + vapt_audit_log (D23 chain of custody).
#
# HITL mode (W7-B) — controls when/how the HITL gate fires:
#   audit_agent (default, MVP) — LLM critic reviews destructive ops, no human blocking
#   human_block                — blocking channel waits for human decision (deferred — NotImplementedError in W7-B)
#   auto_approve (debug only)  — skip review entirely, approve immediately
# Per-scan override: set vapt_scans.hitl_mode when creating a scan.
VAPT_AI_HITL_MODE=audit_agent
#
# VAPT_AI_HITL_AUDIT_MODEL overrides the audit model entirely (litellm format).
# If unset, defaults are derived from VAPT_AI_MODEL_PROVIDER:
#   openai -> gpt-4o-mini, anthropic -> claude-3-5-haiku-latest, glm -> glm-4-flash,
#   minimax -> abab6.5s-chat, deepseek -> deepseek-chat, groq -> groq/llama-3.1-8b-instant,
#   google -> gemini/gemini-1.5-flash, ollama -> ollama/llama3.1:8b
# Suggested: use a cheap, fast model for audit (e.g. gpt-4o-mini or glm-4-flash) —
# the audit call adds ~2-3s latency per destructive op.
#VAPT_AI_HITL_AUDIT_MODEL=gpt-4o-mini
VAPT_AI_HITL_AUDIT_MODE=approval
# approval       — decide approve/reject only (default)
# review_edit    — may also suggest narrower args (suggest_alternative outcome)

VAPT_AI_HITL_AUDIT_TEMPERATURE=0.1
VAPT_AI_HITL_AUDIT_MAX_TOKENS=1024
VAPT_AI_HITL_AUDIT_TIMEOUT_SECONDS=90

# Fallback policy when LLM call fails (timeout / API error / malformed JSON):
#   reject  — safe default (skip the tool call) — RECOMMENDED for production
#   approve — debug only (run the tool without review)
VAPT_AI_HITL_AUDIT_FALLBACK=reject

# ---------- Provider Base URLs (optional overrides) ----------
# API keys are stored encrypted in PostgreSQL, managed via Admin Dashboard
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SSL_VERIFY=true
ANTHROPIC_MAX_TOKENS=2000
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_TIMEOUT_SECONDS=60
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MINIMAX_BASE_URL=https://api.minimax.chat/v1
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Email/SMTP ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=noreply@vapt-ai.local
SMTP_FROM_NAME=VAPT-AI

# ---------- Celery ----------
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- KG Autoresearch (GitHub Issues) ----------
# Required to open kg-pending issues from collectors (NVD / GHSA / aihackai).
# Token needs `repo` scope (issues:write) on GITHUB_REPO.
# GITHUB_TOKEN=ghp_xxx
# GITHUB_REPO=evvolabs/evvo-vapt-frontend
# Background scheduler (disabled by default). Runs collect_and_propose every N hours.
AUTORESEARCH_KG_ENABLED=false
AUTORESEARCH_KG_INTERVAL_HOURS=24
AUTORESEARCH_KG_MAX_NEW_ISSUES=10

# ---------- VAPT Tools ----------
# NUCLEI_PATH=nuclei
# SQLMAP_PATH=sqlmap
# NMAP_PATH=nmap
# VAPT_OUTPUT_DIR=./scan_results
# VAPT_TIMEOUT=300

# ---------- MCP (Model Context Protocol) ----------
VAPT_AI_MCP_ENABLED=true
VAPT_AI_MCP_METASPLOIT_ENABLED=true
VAPT_AI_MCP_SCOPE_ENFORCE=true

# ---------- Metasploit RPC (msfrpcd) ----------
# Start msfrpcd directly on Ubuntu (NO Docker — v3.2 policy):
#   msfrpcd -U msfuser -P <strong-password> -a 127.0.0.1 -p 55553 -f
# Save the password below.
MSF_RPC_HOST=127.0.0.1
MSF_RPC_PORT=55553
MSF_RPC_USER=msfuser
MSF_RPC_PASSWORD=nhat@VKU
MSF_RPC_SSL=false
MSF_RPC_TIMEOUT=60

# ---------- RL (W16 — Dueling Double DQN) ----------
# Master switch. When false, agent uses rule-based fallback (no learning).
VAPT_AI_RL_ENABLED=true

# State / action dimensions (must match StateEncoder + ACTION_SPACE).
# Default 337 = 8 scalars + 256 tech multi-hot + 32 last-vector + 32 last-tool + 9 flags.
VAPT_AI_RL_STATE_DIM=337
VAPT_AI_RL_ACTION_DIM=7
VAPT_AI_RL_HIDDEN_DIM=64

# Q-network hyperparameters.
VAPT_AI_RL_LEARNING_RATE=0.001
VAPT_AI_RL_GAMMA=0.95
VAPT_AI_RL_TAU=0.005

# Epsilon schedule (master plan §12 W16: ε 1.0 → 0.05 over 200 scans).
VAPT_AI_RL_EPSILON_START=1.0
VAPT_AI_RL_EPSILON_END=0.05
VAPT_AI_RL_EPSILON_DECAY_SCANS=200

# Exploration strategy: epsilon_greedy (default) | boltzmann | curiosity
VAPT_AI_RL_EXPLORATION_MODE=epsilon_greedy
VAPT_AI_RL_BOLTZMANN_TEMP_START=1.0

# Prioritized Experience Replay (Schaul et al. 2016).
# alpha: 0=uniform, 1=full prioritization. Default 0.6.
# beta: 0.4 → 1.0 annealed over 100,000 steps (IS weight correction).
VAPT_AI_RL_PER_ALPHA=0.6
VAPT_AI_RL_PER_BETA_START=0.4
VAPT_AI_RL_BUFFER_SIZE=50000
VAPT_AI_RL_BATCH_SIZE=64

# Reward shaping is hardcoded per D26 in app/rl/reward.py — no env override.
# D26 rewards: +5 tier1 / +3 tier2 / +1 verified / +0.5 recon /
#              -1 timeout / -2 fp / -3 scope / -5 abort / -10 no-hitl / +10 complete


# ============================================================================
# RL Harness Bridge (Phase 1)
# ----------------------------------------------------------------------------
# Toggle the per-scan RL harness on/off. When on, the ReAct agent loop
# queries the policy each turn, injects an advisory system message, and
# records (s, a, r, s') transitions into the PER buffer for offline
# DQN training. Set to "false" to run the agent with RL fully disabled
# (zero RL code paths execute — useful for A/B comparison or rollback).
# ----------------------------------------------------------------------------
VAPT_AI_RL_HARNESS_ENABLED=true

# Background training worker drains the PER buffer every N turns. Lower
# values train more aggressively (faster policy improvement, more lock
# contention on the Q-network). Higher values train less often (slower
# improvement, smoother scan latency). Default 5 is a good balance for
# 100-turn scans.
VAPT_AI_RL_TRAIN_INTERVAL_TURNS=5

# PER batch size for each training step. 64 is the standard PER default.
# Larger batches improve gradient quality but block the Q-network longer
# (each batch holds the _q_lock for ~50 ms).
VAPT_AI_RL_TRAIN_BATCH_SIZE=64

# Minimum PER buffer size before training starts. Prevents wasting compute
# on tiny batches that produce noisy gradients. Once the buffer crosses
# this threshold, training begins.
VAPT_AI_RL_MIN_BUFFER_FOR_TRAIN=32


# ---------- KG (W17 — Dynamic Knowledge Graph + Phase 2 Integration) ----------
# Master switch. When false, agent has no KG memory (paths not ranked by history).
#
# Phase 2 — KG integration. When on, the agent loop:
#   1. Parses the first recon tool's output for tech-stack tokens.
#   2. Consults the KG for prior-attack intel on that stack.
#   3. Injects an advisory brief as a system message on the next turn.
#   4. Records consult hit/miss after each record_vulnerability call so
#      KG edge probabilities update.
#   5. Exposes a `consult_kg` tool the LLM can call manually mid-scan.
#
# Set to "false" to disable KG entirely (the harness degrades gracefully
# to RL-only mode — no KG consults, no outcome recording, no consult_kg
# tool effect).
VAPT_AI_KG_ENABLED=true

# Path query params (get_attack_paths BFS).
VAPT_AI_KG_MAX_DEPTH=4

# Max number of attack paths to include in each KG brief. Higher values
# give the LLM more options but bloat the system message. 5 is a good
# balance for ~2k-token briefs.
VAPT_AI_KG_TOP_K=5

# EGATS UCB1 bandit params (master plan §12 W17):
#   UCB(p) = phi(p) + c*sqrt(ln(N)/n_p) - lambda*delta(p) + mu*specificity(p)
# UCB_C: exploration constant (sqrt(2) ≈ 1.4142)
VAPT_AI_KG_UCB_C=1.4142135623730951
# LAMBDA_PENALTY: TDI penalty weight (higher = avoid hard paths)
VAPT_AI_KG_LAMBDA_PENALTY=0.5
# K_MIN_PRUNE: min attempts before pruning at TDI > 0.6
VAPT_AI_KG_K_MIN_PRUNE=3
# EMA_ALPHA: EMA smoothing for TDI (0..1, higher = faster adaptation)
VAPT_AI_KG_EMA_ALPHA=0.3
# MU_SPECIFICITY: inventory specificity boost (small nudge for matching paths)
VAPT_AI_KG_MU_SPECIFICITY=0.2

# Advisory framing toggle. When true (default), KG hints are rendered as
# "Past hits on similar stacks" (advisory — LLM free to ignore). When
# false, hints are rendered as "Recommended Path" (directive). Phase 2
# ships advisory-only — this flag is reserved for future use.
VAPT_AI_KG_ADVISORY_ONLY=true

# Per-scan KG fork (isolation mode). When true, each scan forks the KG
# and buffers writes to the fork; the fork is merged into the main KG
# only when the scan completes successfully. When false (default), all
# writes go straight to the main KG. Phase 2 ships with this off — the
# flag is reserved for future use.
VAPT_AI_KG_ISOLATION=false

# KG is seeded at startup from: 24 skills + 119 WSTG + 44 ATT&CK nodes (P=0.5 each).


# ---------- NVD / CVE (W8-B) ----------
VAPT_AI_NVD_ENABLED=true
# VAPT_AI_NVD_API_KEY=your-nvd-api-key-here  # Optional, raises rate limit
VAPT_AI_NVD_CACHE_TTL_HOURS=24
VAPT_AI_NVD_TIMEOUT_SECONDS=15


# ============================================================================
# Task Difficulty Assessment (Phase 3)
# ----------------------------------------------------------------------------
# Toggle TDA on/off. When on, the harness computes a Task Difficulty Index
# (TDI) each turn from 4 dimensions:
#   H = horizon (remaining_steps / max_horizon)
#   E = evidence confidence (mean of per-finding scores)
#   C = context load (tokens_used / context_window)
#   S = historical success (Laplace-smoothed: (successes+1)/(attempts+2))
#
# TDI = 0.30*H + 0.30*(1-E) + 0.20*C + 0.20*(1-S)
#
# Mode selection:
#   TDI > 0.60  -> BROADEN   (expand recon — task is hard)
#   TDI <= 0.60 -> LLM_PICK  (let LLM decide)
#   EXPLOIT is NOT a formula threshold — it is emitted only by the
#   critical override below (a confirmed finding exists). A `TDI < 0.30`
#   rule is mathematically unreachable before a finding exists.
#
# The mode hint is injected as an advisory system message (alongside RL
# guidance + KG brief). Set to "false" to disable TDA entirely.
# ----------------------------------------------------------------------------
VAPT_AI_TDA_ENABLED=true

# Horizon denominator for TDI normalisation. 0 = auto: use the scan's
# actual turn budget (max_turns, e.g. 100). Do NOT set this below the
# scan budget: a fixed 20 against a 100-turn scan clamps H to 1.0 for
# 80% of the run and removes the horizon dimension from the signal.
# Values larger than max_turns are allowed (H decays more slowly).
VAPT_AI_TDA_MAX_HORIZON=0

# Critical override: when a CONFIRMED finding exists (evidence score
# >= CONFIRMED_VULN = 0.8, i.e. verifier-accepted / replay-verified /
# human-verified), force EXPLOIT mode regardless of the raw TDI. This
# prevents the agent from broadening reconnaissance after a confirmed
# finding (the #1 bug in the reference design — without this, the agent
# loops in broaden_recon after confirming a SQLi instead of deepening
# the finding).
#
# The gate is evidence-based, NOT count-based: a merely plausible
# finding (0.5 — e.g. recorded from scanner output with no reproduced
# result) does not lock the scan onto that vector. The override keeps
# the raw TDI/dimension values so the RL state encoder still sees a
# real difficulty signal.
#
# Set to "false" only for debugging TDI computation — production scans
# should always leave this on.
VAPT_AI_TDA_FORCE_EXPLOIT_ON_FINDING=true


# ============================================================================
# EGATS — Evidence-Guided Attack Tree Search (Phase 4)
# ----------------------------------------------------------------------------
# Toggle EGATS on/off. When on, the harness:
#   1. Seeds attack paths from the KG after the first KG consult.
#   2. Selects the highest-UCB alive path each turn.
#   3. Injects the path as an advisory system message (alongside RL + TDA + KG).
#   4. Records outcome (success/fail) on the selected path after each
#      record_vulnerability call.
#   5. Prunes paths with attempts >= 3 AND tdi_ema > 0.60 (TDI_BROADEN).
#
# Set to "false" to disable EGATS entirely (no path hint, no outcome
# recording, no pruning).
# ----------------------------------------------------------------------------
VAPT_AI_EGATS_ENABLED=true

# UCB exploration constant. Default sqrt(2) ≈ 1.414 — the standard UCB1
# value. Higher = more exploration (try unattempted paths more often).
# Lower = more exploitation (stick with known-good paths).
VAPT_AI_EGATS_UCB_C=1.4142135623730951

# TDI penalty weight (lambda in the UCB formula). Paths with high TDI
# EMA (consistently hard) get penalised. Default 0.5 — balanced.
VAPT_AI_EGATS_LAMBDA=0.5

# Min attempts before a path can be pruned. Default 3 — gives each path
# at least 3 tries before declaring it a dead end.
VAPT_AI_EGATS_K_MIN_PRUNE=3

# TDI EMA smoothing factor. New TDI value contributes ema_alpha to the
# running average, old value contributes (1 - ema_alpha). Default 0.3 —
# the EMA is slow to change, preventing single bad turns from pruning
# a path.
VAPT_AI_EGATS_EMA_ALPHA=0.3

# Specificity boost weight (mu in the UCB formula). Paths that match
# the target's inventory precisely (exact product+version) get a UCB
# boost. Default 0.2 — small enough to nudge ordering without
# dominating the score.
VAPT_AI_EGATS_MU_SPECIFICITY=0.2


# ============================================================================
# Self-Correction on Verifier Rejection (Phase 5)
# ----------------------------------------------------------------------------
# Toggle Self-Correction on/off. When on, the harness:
#   1. Tracks rejection patterns in-memory (vuln_type + normalized_endpoint).
#   2. Renders a 3-tier corrective message (corrective → warning → blacklist).
#   3. Pushes an escalating RL reward (-5/-7/-10) into the PER store with
#      high priority (priority = |reward| * 2).
#   4. Injects the corrective message as a system message on the next turn.
#
# Set to "false" to disable Self-Correction entirely (no corrective message,
# no escalating reward, no pattern tracking).
# ----------------------------------------------------------------------------
VAPT_AI_SC_ENABLED=true

# Thresholds for the 3-tier feedback (do not change unless you understand
# the tradeoffs):
#   pattern_count >= 2  → Tier 2 (bias warning)
#   pattern_count >= 3  → Tier 3 (blacklist warning)
#
# These are hardcoded in app/rl/self_correction.py as DEFAULT_WARNING_THRESHOLD
# and DEFAULT_BLACKLIST_THRESHOLD. To override, edit those constants — env
# overrides are not supported in Phase 5 (would add complexity for little gain).

# ============================================================================
# Per-Scan KG Fork — Isolation Mode (Phase 6)
# ----------------------------------------------------------------------------
# When true, each scan forks the KG into a per-scan deepcopy at attach time.
# All consult/hit/miss/edge_outcome writes go to the fork. The fork is
# merged back into the main KG ONLY when scan status="completed" —
# failed/aborted/max_iterations scans discard the fork to avoid corrupting
# the global KG with partial learning signals.
#
# Default: false (Phase 2-5 behavior — writes go straight to main KG).
#
# Set to "true" for production deployments where multiple scans may run
# concurrently and you want to guarantee that a crashed/aborted scan
# doesn't poison the shared KG.
# ----------------------------------------------------------------------------
VAPT_AI_KG_ISOLATION=false